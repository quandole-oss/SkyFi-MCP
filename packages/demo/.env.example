# SkyFi API Key (required)
# Format: email:hash  (e.g. user@example.com:abc123...)
# Get yours at https://app.skyfi.com/settings/api
SKYFI_API_KEY=

# LLM Provider — set at least one:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides (usually not needed):
# SKYFI_API_BASE_URL=https://app.skyfi.com/platform-api
# SKYFI_AUTH_HEADER=X-Skyfi-Api-Key
