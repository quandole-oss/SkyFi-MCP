# =============================================================================
# SkyFi MCP Server — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ---------------------------------------------------------------------------
# Required: SkyFi API Key
# ---------------------------------------------------------------------------
# Your SkyFi Platform API key. Obtain one at:
# https://app.skyfi.com/settings/api
SKYFI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: SkyFi API Base URL
# ---------------------------------------------------------------------------
# Override the default SkyFi API base URL (for staging/testing).
# Default: https://app.skyfi.com/platform-api
# SKYFI_API_BASE_URL=https://app.skyfi.com/platform-api

# ---------------------------------------------------------------------------
# Remote Server (Cloudflare Worker) — set via wrangler secrets
# ---------------------------------------------------------------------------
# Webhook signing secret for verifying incoming SkyFi webhook payloads.
# SKYFI_WEBHOOK_SIGNING_SECRET=

# OAuth client secret (if using browser-based OAuth flow).
# OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional: Logging
# ---------------------------------------------------------------------------
# Python log level for the MCP server.
# Default: INFO
# LOG_LEVEL=INFO
